#!/usr/bin/env python3

import json
import re

CVE_JSON_TO_FIELD_NAME = {
    'summary' : 'SUMMARY',
    'scorev2' : 'CVSS v2 BASE SCORE',
    'scorev3' : 'CVSS v3 BASE SCORE',
    'vector'  : 'VECTOR',
    'link'    : 'MORE INFORMATION',
}

CVSS_SCORE_V3_INVALID = '0.0'
CVSS_SCORE_V2_TO_SEVERITY = {
    3.9  : 'Low',
    6.9  : 'Medium',
    10.0 : 'High'
}
CVSS_SCORE_V3_TO_SEVERITY = {
    3.9  : 'Low',
    6.9  : 'Medium',
    8.9  : 'High',
    10.0 : 'Critical'
}

def _is_url(string):
    regex = r"(?i)\b((?:https?://|www\d{0,3}[.]|[a-z0-9.\-]+[.][a-z]{2,4}/)(?:[^\s()<>]+|\(([^\s()<>]+|(\([^\s()<>]+\)))*\))+(?:\(([^\s()<>]+|(\([^\s()<>]+\)))*\)|[^\s`!()\[\]{};:'\".,<>?«»“”‘’]))"
    return re.match(regex,string)

def get_severity_from_issue(issue):
    ret = 'unknown'

    if issue.get('scorev3', CVSS_SCORE_V3_INVALID) != CVSS_SCORE_V3_INVALID:
        _table = CVSS_SCORE_V3_TO_SEVERITY
        _score = issue['scorev3']
    else:
        _table = CVSS_SCORE_V2_TO_SEVERITY
        _score = issue['scorev2']

    for _key, _value in _table.items():
        if float(_score) <= _key:
            ret = _value
            break

    return ret

def read_cves_from_file(filename):
    cves = {}

    with open(filename, 'r') as f:
        data = json.load(f)

    for pkg in data['package']:
        pkgname = pkg['name'] + '-' + pkg['version']
        cves[pkgname] = pkg['issue']

    return cves

if __name__ == '__main__':
    import argparse, re

    parser = argparse.ArgumentParser(description='Process yocto generated CVE files')
    parser.add_argument('CVELOG', metavar='logfile', type=str, help='Log file to parse (e.g. build/tmp/work/nginx/<version>/temp/cve.log)')
    parser.add_argument('--filter', type=str, default='status=Unpatched', help='Filter cves. (default "status=Unpatched")')
    parser.add_argument('--summary', action='store_true', help='Print summary')
    parser.add_argument('--format', type=str, choices=['raw', 'warnings-ng'], default='raw', help='Select output format (default=raw python object)')
    parser.add_argument('--machine', type=str, help='Set machine name used in output formats, supporting it')

    args = parser.parse_args()

    cves = read_cves_from_file(args.CVELOG)

    if args.filter:
        def filter_equal(a, b):
            return a == b
        def filter_not_equal(a, b):
            return a != b
        def filter_smaller_or_equal(a, b):
            return a <= b
        def filter_smaller(a, b):
            return a < b
        def filter_larger_or_equal(a, b):
            return a >= b
        def filter_larger(a, b):
            return a > b

        filtered_cves = {}
        filter_func = {
            '=' : filter_equal,
            '!=': filter_not_equal,
            '<' : filter_smaller,
            '<=': filter_smaller_or_equal,
            '>' : filter_larger,
            '>=': filter_larger_or_equal,
        }
        filter_key, filter_condition, filter_value = re.match('(.*)([!=<>]+)(.*)', args.filter).groups()
        _func = filter_func[filter_condition]

        for component in cves:
            for _cve in cves[component]:
                add_to_filter_list = True
                if filter_key in _cve:
                    if not _func(_cve[filter_key], filter_value):
                        add_to_filter_list = False

                if add_to_filter_list:
                    if component not in filtered_cves:
                        filtered_cves[component] = []

                    filtered_cves[component].append(_cve)

        cves = filtered_cves

    if args.format == 'raw':
        import pprint
        pprint.pprint(cves)
    elif args.format == 'warnings-ng':
        SEVERITY_TO_WARNINGSNG = {
            'Low'      : 'LOW',
            'Medium'   : 'NORMAL',
            'High'     : 'HIGH',
            'Critical' : 'ERROR',
        }
        _output = {}
        _output['_class'] = 'io.jenkins.plugins.analysis.core.restapi.ReportApi'
        _output['issues'] = []
        _total = 0
        for _comp in cves:
            _issues = cves[_comp]
            for _issue in _issues:
                _new_issue = {}
                # mis-use fileName as machine name, so filtering for machines is possible in Jenkins
                if args.machine:
                    _new_issue['fileName'] = args.machine

                _new_issue['severity']    = SEVERITY_TO_WARNINGSNG[get_severity_from_issue(_issue)]
                _new_issue['category']    = 'CVE'
                _new_issue['type']        = _issue['id']
                _new_issue['packageName'] = _comp

                # Build HTML description from all interesting fields
                _descr = ''
                for json_fieldname, html_fieldname in CVE_JSON_TO_FIELD_NAME.items():
                    _descr += '<b>' + html_fieldname + ': ' + '</b>'
                    if _is_url(_issue[json_fieldname]):
                        _descr += '<a href="{0}" target="_blank">{0}</a>'.format(_issue[json_fieldname])
                    else:
                        _descr += _issue[json_fieldname]
                    _descr += '<br>'
                _new_issue['description'] = _descr

                _output['issues'].append(_new_issue)
                _total += 1

        _output['size'] = _total
        print(json.dumps(_output, indent=4))

    if args.summary:
        _total_cnt=0
        print("\nCVE statistics:")
        print("-" * 32)
        for component in cves:
            print("{0: <24}: {1}".format(component, len(cves[component])))
            _total_cnt += len(cves[component])
        print("-" * 32)
        print("{0: <24}: {1}".format("Total", _total_cnt))

