+from firewall.core.fw_nm import nm_get_interfaces_in_zone
+
 
 class FirewallZone(object):
     def __init__(self, fw):
@@ -158,6 +160,13 @@ class FirewallZone(object):
             for args in obj.interfaces:
                 error = self._first_except(error, self.add_interface, obj.name, args,
                                            use_zone_transaction=zone_transaction)
+
+            nm_interfaces = nm_get_interfaces_in_zone(obj.name)
+            for intf in nm_interfaces:
+                if intf not in obj.interfaces:
+                    error = self._first_except(error, self.add_interface, obj.name, intf,
+                                               use_zone_transaction=zone_transaction)
+
             for args in obj.sources:
                 error = self._first_except(error, self.add_source, obj.name, args,
                                            use_zone_transaction=zone_transaction)
