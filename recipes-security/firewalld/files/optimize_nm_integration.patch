From 4a1d7d3164f75b5f65f73bbc5e90289ce8a9431b Mon Sep 17 00:00:00 2001
From: Michael Trensch <mtrensch@hilscher.com>
Date: Tue, 7 Feb 2023 08:42:30 +0100
Subject: [PATCH] Firewalld only uses the network connections actively passed
 by NetworkManager via dbus (see
 https://firewalld.org/documentation/zone/connections-interfaces-and-sources.html)

NetworkManager only adds active connections, thus firewalld only shows
zones of active interfaces

This patch adds:
 - When saving runtime to permanent, the zone is updated in NetworkManager
 - Removes all zones from interfaces/connections in NetworkManager,
   when not explicitely assigned in firewalld (Default zone)
 - Search for inactive interfaces in NetworkManager during zone setup
   to also show inactive interfaces per default. Hot-plugged interfaces
   may need a firewall-cmd --reload
 - Ommit removeInterface notification from NetworkManager to have all
   interfaces (up and down) in internal list

NOTE: If multiple connections share the same interface (e.g. WiFi client
      with multiple SSIDs) this will not work
---
 src/firewall-cmd.in              | 18 +++++++++++++++-
 src/firewall/core/fw_nm.py       | 35 +++++++++++++++++++++++++++++---
 src/firewall/core/fw_zone.py     |  9 ++++++++
 src/firewall/server/firewalld.py | 26 ++++++++++++++++--------
 4 files changed, 76 insertions(+), 12 deletions(-)

diff --git a/src/firewall-cmd.in b/src/firewall-cmd.in
index f78fedb4..8bdaae0c 100755
--- a/src/firewall-cmd.in
+++ b/src/firewall-cmd.in
@@ -36,7 +36,8 @@ from firewall import errors
 from firewall.functions import joinArgs, splitArgs
 from firewall.core.fw_nm import nm_is_imported, \
     nm_get_connection_of_interface, nm_get_zone_of_connection, \
-    nm_set_zone_of_connection, nm_get_interfaces_in_zone
+    nm_set_zone_of_connection, nm_get_interfaces_in_zone, \
+    nm_get_connections
 from firewall.core.io.zone import zone_reader
 from firewall.core.io.service import service_reader
 from firewall.core.io.ipset import ipset_reader
@@ -473,7 +474,22 @@ def try_set_zone_of_interface(_zone, interface):
                     cmd.print_msg("The interface is under control of NetworkManager, setting zone to default.")
                 else:
                     cmd.print_msg("The interface is under control of NetworkManager, setting zone to '%s'." % _zone)
+                # On active interfaces NetworkManager will send Add/Remove/ChangeZone, but for inactive interfaces, we
+                # need to do it manually nm_get_connections lists all active connections
+                old_zone = nm_get_zone_of_connection(connection)
+                connections = {}
+                connection_names = {}
+                nm_get_connections(connections, connection_names)
+
                 nm_set_zone_of_connection(_zone, connection)
+
+                if connection not in connection_names:
+                    # Update inactive connection manually
+                    if old_zone != _zone:
+                        fw.removeInterface(old_zone, interface)
+                    if _zone != "":
+                        fw.addInterface(_zone, interface)
+
                 return True
     return False
 
diff --git a/src/firewall/core/fw_nm.py b/src/firewall/core/fw_nm.py
index 37282a1a..ec114c2e 100644
--- a/src/firewall/core/fw_nm.py
+++ b/src/firewall/core/fw_nm.py
@@ -24,7 +24,8 @@
 __all__ = [ "check_nm_imported", "nm_is_imported",
             "nm_get_zone_of_connection", "nm_set_zone_of_connection",
             "nm_get_connections", "nm_get_connection_of_interface",
-            "nm_get_bus_name", "nm_get_dbus_interface" ]
+            "nm_get_bus_name", "nm_get_dbus_interface",
+            "nm_reset_zone_for_unassigned_interfaces" ]
 
 import gi
 from gi.repository import GLib
@@ -171,17 +172,36 @@ def nm_get_interfaces():
         for dev in active_con.get_devices():
             active_interfaces.append(dev.get_iface())
 
+    connections = nm_get_client().get_connections()
+
+    for c in connections:
+        s_conn = c.get_setting(NM.SettingConnection)
+        c_itf = s_conn.get_interface_name()
+        if c_itf not in active_interfaces:
+            active_interfaces.append(c_itf)
+
     return active_interfaces
 
 def nm_get_interfaces_in_zone(zone):
     interfaces = []
     for interface in nm_get_interfaces():
         conn = nm_get_connection_of_interface(interface)
-        if zone == nm_get_zone_of_connection(conn):
+        if conn != None and zone == nm_get_zone_of_connection(conn):
             interfaces.append(interface)
 
     return interfaces
 
+def _nm_get_inactive_connection_of_interface(interface):
+    connections = nm_get_client().get_connections()
+
+    for c in connections:
+        s_conn = c.get_setting(NM.SettingConnection)
+        c_itf = s_conn.get_interface_name();
+        if c_itf == interface:
+            return c.get_uuid()
+
+    return None
+
 def nm_get_connection_of_interface(interface):
     """Get connection from NM that is using the interface
     @param interface name
@@ -195,7 +215,7 @@ def nm_get_connection_of_interface(interface):
 
     active_con = device.get_active_connection()
     if active_con is None:
-        return None
+        return _nm_get_inactive_connection_of_interface(interface)
 
     try:
         con = active_con.get_connection()
@@ -226,3 +246,12 @@ def nm_get_dbus_interface():
     if not _nm_imported:
         return ""
     return NM.DBUS_INTERFACE
+
+def nm_reset_zone_for_unassigned_interfaces(assigned_interfaces):
+    connections = nm_get_client().get_connections()
+
+    for c in connections:
+        s_conn = c.get_setting(NM.SettingConnection)
+        c_itf = s_conn.get_interface_name();
+        if not c_itf in assigned_interfaces:
+            nm_set_zone_of_connection(None, c.get_uuid())
