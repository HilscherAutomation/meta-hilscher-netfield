From b2b2fdfd2a2805425d9b0668bfefad29a08a7266 Mon Sep 17 00:00:00 2001
From: OpenEmbedded <oe.patch@oe>
Date: Fri, 25 Jan 2019 06:33:55 +0000
Subject: [PATCH] It seems xattrs were restored too early, thus capabilities
 were not correctly restored

---
 src/extract.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/extract.c b/src/extract.c
index b241345..d0c8f0d 100644
--- a/src/extract.c
+++ b/src/extract.c
@@ -297,10 +297,6 @@ set_stat (char const *file_name,
 	 give files away.  */
     }
 
-  xattrs_acls_set(st, file_name, typeflag);
-  xattrs_selinux_set(st, file_name, typeflag);
-  xattrs_xattrs_set(st, file_name, typeflag);
-
   if (0 < same_owner_option && permstatus != INTERDIR_PERMSTATUS)
     {
       /* When lchown exists, it should be used to change the attributes of
@@ -337,6 +333,10 @@ set_stat (char const *file_name,
   if (typeflag != SYMTYPE)
     set_mode (file_name, &st->stat, cur_info,
 	      invert_permissions, permstatus, typeflag);
+
+  xattrs_acls_set(st, file_name, typeflag);
+  xattrs_selinux_set(st, file_name, typeflag);
+  xattrs_xattrs_set(st, file_name, typeflag);
 }
 
 /* Remember to restore stat attributes (owner, group, mode and times)
