// Allow netadmin user to handle cifxtun service
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "cifxtun.service" &&
        ["start", "stop", "restart"].indexOf(action.lookup("verb")) !== -1 &&
        subject.active &&
        subject.isInGroup ("netadmin")) {
    return polkit.Result.YES;
  }
});

// Support for enable/disable of cifxtun service
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-unit-files" &&
        action.lookup("unit") == "cifxtun.service" &&
        ["enable", "disable"].indexOf(action.lookup("verb")) !== -1 &&
        subject.active &&
        subject.isInGroup ("netadmin")) {
    return polkit.Result.YES;
  }
});
