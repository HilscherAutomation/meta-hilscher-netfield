   if (session == NULL)
     {
       g_set_error (error,
@@ -2887,6 +2884,8 @@ polkit_backend_interactive_authority_authentication_agent_response (PolkitBacken
   if (user_of_caller != NULL)
     g_object_unref (user_of_caller);
 
+  g_clear_object (&session_for_caller);
+
   return ret;
 }
 
