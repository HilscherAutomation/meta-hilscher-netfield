                                         authority,
                                         user_identities,
@@ -2437,6 +2421,7 @@ authentication_agent_initiate_challenge (AuthenticationAgent         *agent,
   g_free (localized_icon_name);
   if (localized_details != NULL)
     g_object_unref (localized_details);
