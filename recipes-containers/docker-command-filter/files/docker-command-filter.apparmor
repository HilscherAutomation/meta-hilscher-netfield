#include <tunables/global>

profile docker-command-filter flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/bash>
  #include <abstractions/consoles>
  #include <abstractions/python>
  #include <abstractions/user-tmp>

  capability dac_read_search,

  @{PROC}/@{pid}/fd/ r,

  /tmp/wgunicorn* rwlk,
  /usr/bin/gunicorn rix,
  /usr/bin/ r,
  /bin/bash{,.bash} rix,
  /bin/uname{,.coreutils} rix,
  /usr/bin/python3.[0-7] rix,

  /{var/,}run/docker/plugins/*.sock rwk,
  /{var/,}run/docker/{,plugins/} rwlk,
  /usr/sbin/{,docker-command-filter.py} r,
  /etc/docker/filter/{,*} r,
  /usr/shared/docker-command-filter/{,**} r,
  deny /**/__pycache__/{,*} rwlk,
}
