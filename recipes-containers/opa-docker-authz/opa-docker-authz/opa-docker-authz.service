[Unit]
Description=Docker OPA policy service
Before=docker.service

[Service]
User=root
Group=docker
PrivateTmp=yes
PrivateNetwork=yes
ExecStartPre=/bin/mkdir -p /run/docker/plugins/
ExecStart=/usr/bin/opa-docker-authz -policy-file /etc/docker/policies/authz.rego

[Install]
WantedBy=multi-user.target
