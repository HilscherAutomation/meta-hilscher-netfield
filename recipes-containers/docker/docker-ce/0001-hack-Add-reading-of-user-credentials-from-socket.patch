From c535091d5f65947a892c08e3a67c7eedbfec4e1d Mon Sep 17 00:00:00 2001
From: MTR <github@hilscher.com>
Date: Wed, 11 Mar 2020 12:00:32 +0100
Subject: [PATCH] hack: Add reading of user credentials from socket.

See:
 * https://stackoverflow.com/questions/29531993/accessing-the-underlying-socket-of-a-net-http-response
 * https://blog.jbowen.dev/2019/09/using-so_peercred-in-go/
---
 components/engine/api/server/server.go        | 80 ++++++++++++++++++-
 .../engine/pkg/authorization/middleware.go    |  8 ++
 2 files changed, 87 insertions(+), 1 deletion(-)

diff --git a/components/engine/api/server/server.go b/components/engine/api/server/server.go
index def0f9f0f0..e4353eafe2 100644
--- a/components/engine/api/server/server.go
+++ b/components/engine/api/server/server.go
@@ -3,14 +3,19 @@ package server // import "github.com/docker/docker/api/server"
 import (
 	"context"
 	"crypto/tls"
+	"fmt"
 	"net"
 	"net/http"
 	"strings"
+	"os/user"
+
+	"golang.org/x/sys/unix"
 
 	"github.com/docker/docker/api/server/httputils"
 	"github.com/docker/docker/api/server/middleware"
 	"github.com/docker/docker/api/server/router"
 	"github.com/docker/docker/api/server/router/debug"
+	"github.com/docker/docker/cmd/dockerd/hack"
 	"github.com/docker/docker/dockerversion"
 	"github.com/docker/docker/errdefs"
 	"github.com/gorilla/mux"
@@ -53,12 +58,19 @@ func (s *Server) UseMiddleware(m middleware.Middleware) {
 	s.middlewares = append(s.middlewares, m)
 }
 
+func ConnStateEvent(conn net.Conn, event http.ConnState) {
+	if event == http.StateHijacked || event == http.StateClosed {
+		delete(conns, conn.RemoteAddr().String())
+	}
+}
+
 // Accept sets a listener the server accepts connections into.
 func (s *Server) Accept(addr string, listeners ...net.Listener) {
 	for _, listener := range listeners {
 		httpServer := &HTTPServer{
 			srv: &http.Server{
 				Addr: addr,
+				ConnState: ConnStateEvent,
 			},
 			l: listener,
 		}
@@ -108,9 +120,53 @@ type HTTPServer struct {
 	l   net.Listener
 }
 
+var conns = make(map[string]net.Conn)
+
+func GetConn(r *http.Request) (net.Conn) {
+	return conns[r.RemoteAddr]
+}
+
+type connSaveListener struct {
+	net.Listener
+}
+
+type remoteAddrPtrConn struct {
+	net.Conn
+	ptrStr string
+}
+func (self remoteAddrPtrConn) RemoteAddr() (net.Addr) {
+	return remoteAddrPtr{self.ptrStr}
+}
+type remoteAddrPtr struct {
+	ptrStr string
+}
+func (remoteAddrPtr) Network() (string) {
+	return ""
+}
+func (self remoteAddrPtr) String() (string) {
+	return self.ptrStr
+}
+
+func NewConnSaveListener(wrap net.Listener) (net.Listener) {
+	return connSaveListener{wrap}
+}
+
+func (self connSaveListener) Accept() (net.Conn, error) {
+	conn, err := self.Listener.Accept()
+	if hack_conn, ok := conn.(*hack.MalformedHostHeaderOverrideConn); ok {
+		if _, isUnix := hack_conn.Conn.(*net.UnixConn); isUnix {
+			ptrStr := fmt.Sprintf("%d", &conn)
+			conns[ptrStr] = conn
+			logrus.Debug("HiJacking unix socket request %+v", conn)
+			return remoteAddrPtrConn{conn, ptrStr}, err
+		}
+	}
+	return conn, err
+}
+
 // Serve starts listening for inbound requests.
 func (s *HTTPServer) Serve() error {
-	return s.srv.Serve(s.l)
+	return s.srv.Serve(NewConnSaveListener(s.l))
 }
 
 // Close closes the HTTPServer from listening for the inbound requests.
@@ -131,7 +187,29 @@ func (s *Server) makeHTTPHandler(handler httputils.APIFunc) http.HandlerFunc {
 		// use intermediate variable to prevent "should not use basic type
 		// string as key in context.WithValue" golint errors
 		ctx := context.WithValue(r.Context(), dockerversion.UAStringKey{}, r.Header.Get("User-Agent"))
+
+		conn := GetConn(r)
+		if conn != nil {
+			if hack_conn, ok := conn.(*hack.MalformedHostHeaderOverrideConn); ok {
+				if unixConn, isUnix := hack_conn.Conn.(*net.UnixConn); isUnix {
+					f, _ := unixConn.File()
+					pcred, _ := unix.GetsockoptUcred(int(f.Fd()), unix.SOL_SOCKET, unix.SO_PEERCRED)
+					f.Close()
+					user, user_err := user.LookupId(fmt.Sprint(pcred.Uid))
+					if user_err == nil {
+						logrus.Debug("Incoming request from %v", user.Username)
+						ctx = context.WithValue(ctx, "username", user.Username)
+					} else {
+						logrus.Debug("Incoming request from %v", pcred.Uid)
+						ctx = context.WithValue(ctx, "username", fmt.Sprint(pcred.Uid))
+					}
+				}
+			}
+		}
+
 		r = r.WithContext(ctx)
+
+
 		handlerFunc := s.handlerWithGlobalMiddlewares(handler)
 
 		vars := mux.Vars(r)
diff --git a/components/engine/pkg/authorization/middleware.go b/components/engine/pkg/authorization/middleware.go
index 39c2dce856..a61a29de26 100644
--- a/components/engine/pkg/authorization/middleware.go
+++ b/components/engine/pkg/authorization/middleware.go
@@ -69,6 +69,14 @@ func (m *Middleware) WrapHandler(handler func(ctx context.Context, w http.Respon
 		if r.TLS != nil && len(r.TLS.PeerCertificates) > 0 {
 			user = r.TLS.PeerCertificates[0].Subject.CommonName
 			userAuthNMethod = "TLS"
+		} else {
+			/* Check context for username which is inserted in HTTP handler, if incoming
+			   request is done via a local socket */
+			if username := r.Context().Value("username"); username != nil {
+				logrus.Debug("Found local username %s in context", username)
+				user = username.(string)
+				userAuthNMethod = "local"
+			}
 		}
 
 		authCtx := NewCtx(plugins, user, userAuthNMethod, r.Method, r.RequestURI)
-- 
