From 266767ad4e06bbd1467cbdc1c699a9e9a87f0e40 Mon Sep 17 00:00:00 2001
From: Michael Trensch <mtrensch@hilscher.com>
Date: Wed, 21 Jun 2023 12:11:11 +0200
Subject: [PATCH 1/2] hack: Add reading of user credentials from socket.

See:
 * https://stackoverflow.com/questions/29531993/accessing-the-underlying-socket-of-a-net-http-response
 * https://blog.jbowen.dev/2019/09/using-so_peercred-in-go/
---
 api/server/server.go            | 55 +++++++++++++++++++++++++++++++++
 cmd/dockerd/daemon.go           | 14 +++++++++
 pkg/authorization/middleware.go | 13 ++++++++
 3 files changed, 82 insertions(+)

diff --git a/api/server/server.go b/api/server/server.go
index 3855197fa2..ee5e9dae76 100644
--- a/api/server/server.go
+++ b/api/server/server.go
@@ -2,7 +2,13 @@ package server // import "github.com/docker/docker/api/server"
 
 import (
 	"context"
+	"fmt"
+	"net"
 	"net/http"
+	"os/user"
+	"strings"
+
+	"golang.org/x/sys/unix"
 
 	"github.com/containerd/log"
 	"github.com/docker/docker/api/server/httpstatus"
@@ -15,6 +21,15 @@ import (
 	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"
 )
 
+// -------------------------------------------------------------------------------------------
+// HACK: Store net.Conn in http context to extract Unix Domain Socket information (user, etc.)
+// -------------------------------------------------------------------------------------------
+func GetConn(r *http.Request) (net.Conn) {
+  log.G(context.TODO()).Debugf("GetConn Context(%+v)", r.Context());
+  return r.Context().Value("http-conn").(net.Conn)
+}
+// -------------------------------------------------------------------------------------------
+
 // versionMatcher defines a variable matcher to be parsed by the router
 // when a request is about to be served.
 const versionMatcher = "/v{version:[0-9.]+}"
@@ -44,6 +59,46 @@ func (s *Server) makeHTTPHandler(handler httputils.APIFunc, operation string) ht
 		// string as key in context.WithValue" golint errors
 		ctx := context.WithValue(r.Context(), dockerversion.UAStringKey{}, r.Header.Get("User-Agent"))
 
+
+		// -------------------------------------------------------------------------------------------
+		// HACK: Store net.Conn in http context to extract Unix Domain Socket information (user, etc.)
+		// -------------------------------------------------------------------------------------------
+		log.G(ctx).Debugf("Calling GetConn(%+v)", r);
+		conn := GetConn(r)
+		log.G(ctx).Debugf("GetConn() returned %+v", conn);
+		if conn != nil {
+			if unixConn, isUnix := conn.(*net.UnixConn); isUnix {
+				var pcred *unix.Ucred
+
+				raw, err := unixConn.SyscallConn()
+				err = raw.Control(func(fd uintptr) {
+					pcred, err = unix.GetsockoptUcred(int(fd),
+									unix.SOL_SOCKET,
+									unix.SO_PEERCRED)
+				})
+
+				if err != nil {
+					log.G(ctx).Warnf("Error extracting credentials from socket %+v", err)
+				}
+
+				socketuser, user_err := user.LookupId(fmt.Sprint(pcred.Uid))
+				if user_err == nil {
+					ctx = context.WithValue(ctx, "username", socketuser.Username)
+					strGroups,_ := socketuser.GroupIds()
+					grouplist := make([]string, len(strGroups))
+					for i, gid := range strGroups {
+						group,_ := user.LookupGroupId(gid)
+						grouplist[i] = group.Name
+					}
+					log.G(ctx).Debugf("Incoming request via domain socket from %s with groups %v (gids=%v)", socketuser.Username, grouplist, strGroups)
+					ctx = context.WithValue(ctx, "usergroups", strings.Join(grouplist[:], ","))
+				} else {
+					log.G(ctx).Warnf("Unable to extract user informatin from socket %v", pcred.Uid)
+				}
+			}
+		}
+		// -------------------------------------------------------------------------------------------
+
 		r = r.WithContext(ctx)
 		handlerFunc := s.handlerWithGlobalMiddlewares(handler)
 
diff --git a/cmd/dockerd/daemon.go b/cmd/dockerd/daemon.go
index 3704042f4f..f7fd15b414 100644
--- a/cmd/dockerd/daemon.go
+++ b/cmd/dockerd/daemon.go
@@ -67,6 +67,15 @@ import (
 	"tags.cncf.io/container-device-interface/pkg/cdi"
 )
 
+// -------------------------------------------------------------------------------------------
+// HACK: Store net.Conn in http context to extract Unix Domain Socket information (user, etc.)
+// -------------------------------------------------------------------------------------------
+func SaveConnInContext(ctx context.Context, c net.Conn) (context.Context) {
+	log.G(context.TODO()).Debugf("SaveConnInContext Context(%+v) GetConn(%+v)", ctx, c);
+	return context.WithValue(ctx, "http-conn", c)
+}
+// -------------------------------------------------------------------------------------------
+
 // DaemonCli represents the daemon CLI.
 type DaemonCli struct {
 	*config.Config
@@ -193,6 +202,11 @@ func (cli *DaemonCli) start(opts *daemonOptions) (err error) {
 
 	httpServer := &http.Server{
 		ReadHeaderTimeout: 5 * time.Minute, // "G112: Potential Slowloris Attack (gosec)"; not a real concern for our use, so setting a long timeout.
+		// -------------------------------------------------------------------------------------------
+		// HACK: Store net.Conn in http context to extract Unix Domain Socket information (user, etc.)
+		// -------------------------------------------------------------------------------------------
+		ConnContext: SaveConnInContext,
+		// -------------------------------------------------------------------------------------------
 	}
 	apiShutdownCtx, apiShutdownCancel := context.WithCancel(context.Background())
 	apiShutdownDone := make(chan struct{})
diff --git a/pkg/authorization/middleware.go b/pkg/authorization/middleware.go
index 8a55b27cbd..8e93315e09 100644
--- a/pkg/authorization/middleware.go
+++ b/pkg/authorization/middleware.go
@@ -69,6 +69,19 @@ func (m *Middleware) WrapHandler(handler func(ctx context.Context, w http.Respon
 		if r.TLS != nil && len(r.TLS.PeerCertificates) > 0 {
 			user = r.TLS.PeerCertificates[0].Subject.CommonName
 			userAuthNMethod = "TLS"
+		} else {
+			/* Check context for username which is inserted in HTTP handler, if incoming
+			   request is done via a local socket */
+			if username := r.Context().Value("username"); username != nil {
+				user = username.(string)
+				log.G(ctx).Debugf("Found local username (%s) from socket", user)
+				userAuthNMethod = "local"
+			}
+			if usergroups := r.Context().Value("usergroups"); usergroups != nil {
+				groups := usergroups.(string)
+				log.G(ctx).Debugf("Setting Authz-Groups from local usergroups %s", groups)
+				r.Header.Add("Authz-Groups", groups)
+			}
 		}
 
 		authCtx := NewCtx(plugins, user, userAuthNMethod, r.Method, r.RequestURI)
-- 
