include <tunables/global>

/usr/libexec/cockpit/iotedge_check_helper {
  #include <abstractions/base>
  #include <abstractions/bash>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/mem rwklx,
  deny @{PROC}/kmem rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/efi/efivars/** rwklx,
  deny /sys/kernel/security/** rwklx,

  capability dac_read_search,
  capability dac_override,

  ptrace peer=**,
  capability sys_ptrace,

  /dev/tty                                   rw,
  /usr/libexec/cockpit/iotedge_check_helper  r,
  /usr/bin/iotedge                           rix,
  /sys/devices/system/cpu/cpufreq/*/scaling_cur_freq r,
  /sys/devices/virtual/dmi/id/* r,
  @{PROC}                r,
  @{PROC}/uptime         r,
  @{PROC}/@{pid}/{cgroup,sched,stat,environ,io,cmdline} r,
  @{PROC}/@{pid}/task/{,**} r,
  @{PROC}/sys/kernel/osrelease r,
  /bin/bash{,.bash}      rix,
  /bin/systemctl         rix,
  /usr/bin/aziotctl      rix,
  /usr/bin/docker        rix,
  /usr/libexec/aziot/aziot-edged rix,
  /var/lib/aziot/** r,
  /etc/ssl/private/iotedge-ca/** r,
  /var/secrets/** r,
  /etc/docker/*          r,
  /etc/aziot/{,**}       r,
}
