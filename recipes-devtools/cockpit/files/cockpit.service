[Unit]
Description=Cockpit Web Service
Documentation=man:cockpit-ws(8)
Requires=cockpit.socket

[Service]
OOMScoreAdjust=-1000
ExecStartPre=+/bin/mkdir -p /etc/systemd/system.conf.d
ExecStartPre=-/bin/mkdir -p /var/lib/swupdate
ExecStartPre=-/bin/rm -f /var/lib/swupdate/*
ExecStartPre=-/usr/sbin/remotectl certificate --ensure --user=root --group=root
ExecStart=/usr/libexec/cockpit-ws --for-tls-proxy
PermissionsStartOnly=true
User=cockpit-ws
Group=cockpit-ws

[Install]
WantedBy=multi-user.target
