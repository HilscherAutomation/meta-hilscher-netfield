#!/bin/sh

factory_default_reset_enabled() {
	return 0
}

factory_default_reset_run() {
	reset_done=0

	for label in backup system; do
		tmp_dev=$(blkid | grep "LABEL=\"${label}\"" | cut -d ":" -f1)
		if [ -b "$tmp_dev" ]; then
			tmpdir=$(mktemp -d)
			mount $tmp_dev $tmpdir

			if [ -e "$tmpdir/.factory_reset" ]; then
				__debug "Found .factory_reset on $tmp_dev"
				data_dev=$(blkid | grep "LABEL=\"data\"" | cut -d ":" -f1)
				if [ -b "$data_dev" ]; then
					__debug "Formatting $data_dev using ext4"
					mkfs.ext4 -q -L data -F /dev/mapper/data-data
					rm $tmpdir/.factory_reset
					reset_done=1
				fi
			fi

			umount $tmpdir
			rmdir $tmpdir
		fi
		[ $reset_done -eq 1 ] && break
	done
}
