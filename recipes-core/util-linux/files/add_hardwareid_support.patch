+static char* read_text_file(const char *filename)
+{
+	int fd  = -1;
+	struct stat st;
+	char* ret = NULL;
+
+	fd = open(filename, O_RDONLY);
+	if(fd != -1) {
+		if (fstat(fd, &st) < 0 || st.st_size > 4 * 1024) {
+			log_warn(_("cannot open file %s"), filename);
+		} else {
+			ret = malloc(st.st_size + 1);
+			if(!ret)
+				log_err(_("failed to allocate memory: %m"));
+			else {
+				char *newline;
+
+				read(fd, ret, st.st_size);
+				if ((newline=strchr(ret, '\n')) != NULL)
+					*newline = '\0';
+				ret[st.st_size] = 0;
+			}
+		}
+		close(fd);
+	}
+
+	return ret;
+}
