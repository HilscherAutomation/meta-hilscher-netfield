diff -aurN a/Makefile b/Makefile
--- a/Makefile	2022-09-05 07:27:44.753414384 +0200
+++ b/Makefile	2022-09-05 07:32:02.907897887 +0200
@@ -38,25 +38,12 @@
 	CARGO_PROFILE_DIRECTORY = release
 endif
 
-ifeq ($(ARCH), arm32v7)
